                <label>$INFO[Control.GetLabel(9099).index(1)]</label>
            </control>
            <!-- White glass underline -->
            <control type="image">
                <height>1</height>
                <left>0</left>
                <right>0</right>
                <bottom>0</bottom>
                <texture colordiffuse="dialog_fg_50">common/white.png</texture>
            </control>
        </control>
